# Copy this file to .modelence.env and replace the placeholders.
# Never commit .modelence.env or real API keys.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat
# Optional direct fallback if OpenRouter is unavailable.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
SERPAPI_API_KEY=your_serpapi_api_key

# Required by Modelence deployments when applicable.
MODELENCE_SERVICE_ENDPOINT=your_modelence_service_endpoint
MODELENCE_SERVICE_TOKEN=your_modelence_service_token
MODELENCE_ENVIRONMENT_ID=your_modelence_environment_id
