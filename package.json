{
  "name": "sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/railway.ts --format esm --platform node --target es2020 --out-dir dist/server",
    "start": "node dist/server/railway.js",
    "dev": "vite --host 0.0.0.0",
