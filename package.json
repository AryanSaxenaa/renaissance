{
  "name": "renaissance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target es2022 --out-dir dist/server --external pg",
    "start": "node dist/server/index.js",
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "eval": "echo \"eval harness not yet wired\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^0.563.0",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.0",
    "serpapi": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.35",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vite": "^6.3.6",
    "vitest": "^3.0.9"
  }
}
