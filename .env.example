# Copy to .env.local for development. Never commit secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# replay (default when SERPAPI_API_KEY unset) | live | record
RENAISSANCE_MODE=replay
RENAISSANCE_STORE=file
RENAISSANCE_DATA_DIR=.data

# Live SerpApi (optional)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_HARD_CAP=240
DAILY_CREDIT_CAP=15
PER_BRIEF_CREDIT_CAP=8

# LLM for brief generation (optional in replay — uses deterministic draft)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Public demo guard (live only)
PUBLIC_DEMO_MODE=false
ACCESS_CODE=

# Postgres on Railway (optional locally)
DATABASE_URL=

RETENTION_DAYS=14
DEFAULT_CITY=Pune
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Leave empty in dev to use Vite proxy (/api → :3000)
VITE_API_URL=
